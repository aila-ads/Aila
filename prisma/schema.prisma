generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipRole {
  OWNER
  MEMBER
}

// Application role, set only by the backend (DATA-ARCHITECTURE §7).
enum UserRole {
  USER
  ADMIN
}

enum TrialStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  UNPAID
}

enum BillingProvider {
  FLUTTERWAVE
  PAYSTACK
  PAYPAL
}

enum PlanCode {
  AILA_PRO
}

// One provider charge (DATA-ARCHITECTURE §14): PENDING while a checkout is
// open, then SUCCEEDED or FAILED from the provider's verified result.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ProductCode {
  INTELLIGENCE
  WRITER
  TRANSLATE
  ADS
  LEGAL
  CODING
}

enum UsageType {
  AI_REQUEST
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  FILE_UPLOAD
  FILE_STORAGE
  PROJECT_CREATED
  EXPORT
}

// Outcome of a metered operation (DATABASE-SCHEMA §18).
enum UsageStatus {
  SUCCESS
  FAILURE
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

// File lifecycle (DATABASE-SCHEMA §26): UPLOADING -> READY, or FAILED;
// DELETED once removed. ACTIVE is kept for existing values but not used.
enum FileStatus {
  ACTIVE
  PROCESSING
  FAILED
  DELETED
  UPLOADING
  READY
}

enum FileSource {
  UPLOAD
  GENERATED
  IMPORTED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum NotificationType {
  SYSTEM
  BILLING
  SECURITY
  PRODUCT
  USAGE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  EMAIL_CHANGE
  SUBSCRIPTION_CHANGE
  ENTITLEMENT_CHANGE
  FILE_ACCESS
  EXPORT
  SECURITY_EVENT
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

// ============================================================
// ACCOUNT / IDENTITY
// ============================================================

model Account {
  id     String        @id @default(uuid(7))
  status AccountStatus @default(ACTIVE)

  name         String?
  primaryEmail String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users         User[]
  memberships   Membership[]
  trial         Trial?
  subscriptions Subscription[]
  entitlements  Entitlement[]
  usageRecords  UsageRecord[]
  files         File[]
  conversations Conversation[]
  notifications Notification[]
  settings      UserSettings?
  auditLogs     AuditLog[]
  billingEvents BillingEvent[]
  payments      Payment[]
  projects      Project[]

  writerProjects      WriterProject[]
  writerNodes         WriterNode[]
  writerVersions      WriterVersion[]
  writerResearchItems WriterResearchItem[]
  writerReferences    WriterReference[]
  writerExports       WriterExport[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id         String @id @default(uuid(7))
  accountId  String
  authUserId String @unique

  email           String    @unique
  emailVerifiedAt DateTime?
  name            String?

  status AccountStatus @default(ACTIVE)
  role   UserRole      @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  memberships     Membership[]
  projects        ProjectMember[]
  createdProjects Project[]
  conversations   Conversation[]
  messages        Message[]
  notifications   Notification[]
  settings        UserSettings?
  auditLogs       AuditLog[]
  usageRecords    UsageRecord[]
  payments        Payment[]
  files           File[]

  writerProjects      WriterProject[]
  writerNodes         WriterNode[]
  writerVersions      WriterVersion[]
  writerResearchItems WriterResearchItem[]
  writerReferences    WriterReference[]
  writerExports       WriterExport[]

  @@index([accountId])
  @@index([status])
}

model Membership {
  id        String @id @default(uuid(7))
  accountId String
  userId    String

  role MembershipRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId])
  @@index([accountId, role])
}

// ============================================================
// TRIAL
// ============================================================

model Trial {
  id        String @id @default(uuid(7))
  accountId String @unique

  startedAt DateTime
  expiresAt DateTime
  endedAt   DateTime?

  status TrialStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// BILLING
// ============================================================

model Subscription {
  id        String @id @default(uuid(7))
  accountId String

  provider               BillingProvider
  providerCustomerId     String?
  providerSubscriptionId String?

  plan   PlanCode
  status SubscriptionStatus

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  billingEvents BillingEvent[]
  payments      Payment[]

  @@unique([provider, providerSubscriptionId])
  @@index([accountId, status])
  @@index([provider, providerCustomerId])
  @@index([currentPeriodEnd])
}

model BillingEvent {
  id             String  @id @default(uuid(7))
  accountId      String?
  subscriptionId String?

  provider        BillingProvider
  providerEventId String

  eventType   String
  payloadHash String

  processedAt DateTime?
  // Why a verified event was rejected or failed (DATABASE-SCHEMA §15).
  errorCode   String?
  createdAt   DateTime  @default(now())

  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([accountId])
  @@index([subscriptionId])
  @@index([eventType])
  @@index([createdAt])
}

// Maps a provider transaction to the account it belongs to and records the
// amount and currency it must match (SECURITY-ARCHITECTURE §21.1). The
// unique provider references make each charge count once.
model Payment {
  id             String  @id @default(cuid())
  accountId      String
  userId         String?
  subscriptionId String?

  provider              BillingProvider
  txRef                 String
  providerTransactionId String?

  plan     PlanCode
  amount   Decimal       @db.Decimal(20, 2)
  currency String        @db.VarChar(3)
  status   PaymentStatus @default(PENDING)
  // A one-month Aila Pro purchase that does not renew on its own; false for
  // the Flutterwave card plan's first charge and its renewals.
  oneTime  Boolean       @default(false)

  // Set only on checkouts Aila created: the provider's hosted link, reused
  // while it is still open. Renewal charges have neither.
  checkoutUrl       String?
  checkoutExpiresAt DateTime?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId])
  // Not unique: Flutterwave sets the reference of renewal charges, and the
  // one transaction ID per charge is what makes it count once.
  @@index([provider, txRef])
  @@index([accountId, status, createdAt])
  @@index([subscriptionId])
}

// ============================================================
// ENTITLEMENTS
// ============================================================

model Entitlement {
  id        String @id @default(uuid(7))
  accountId String

  product ProductCode
  key     String
  status  EntitlementStatus @default(ACTIVE)

  source      String
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
  @@index([accountId, status])
  @@index([product, status])
  @@index([expiresAt])
}

// ============================================================
// USAGE
// ============================================================

model UsageRecord {
  id String @id @default(uuid(7))

  accountId String
  userId    String?

  product   ProductCode?
  usageType UsageType

  quantity Decimal @db.Decimal(20, 6)
  unit     String?

  // What was done, e.g. the AI capability (DATABASE-SCHEMA §18).
  operation String?

  model    String?
  provider String?

  requestId      String?
  idempotencyKey String?

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  estimatedCost Decimal? @db.Decimal(20, 8)
  currency      String?

  durationMs Int?
  status     UsageStatus?

  metadata Json?

  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  // Per-account usage-limit counts (AI-GATEWAY §14).
  @@index([accountId, usageType, createdAt])
  @@index([userId, createdAt])
  @@index([product, createdAt])
  @@index([usageType, createdAt])
  @@index([requestId])
  @@index([idempotencyKey])
}

// ============================================================
// PROJECTS
// ============================================================

model Project {
  id        String @id @default(uuid(7))
  accountId String

  name        String
  description String?

  status ProjectStatus @default(ACTIVE)

  createdById String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  members       ProjectMember[]
  folders       Folder[]
  files         File[]
  conversations Conversation[]

  @@index([accountId, status])
  @@index([createdById])
  @@index([updatedAt])
}

model ProjectMember {
  id        String @id @default(uuid(7))
  projectId String
  userId    String

  role ProjectRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Folder {
  id        String @id @default(uuid(7))
  projectId String

  parentId String?

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  files    File[]

  @@index([projectId])
  @@index([parentId])
}

// ============================================================
// FILES
// ============================================================

model File {
  id String @id @default(uuid(7))

  accountId String
  userId    String

  projectId String?
  folderId  String?

  name      String
  mimeType  String
  sizeBytes BigInt

  storageKey String  @unique
  checksum   String?

  source FileSource
  status FileStatus @default(PROCESSING)

  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  versions FileVersion[]

  writerReferences WriterReference[]
  writerExport     WriterExport?

  @@index([accountId, status])
  @@index([userId])
  @@index([projectId])
  @@index([folderId])
  @@index([createdAt])
}

model FileVersion {
  id     String @id @default(uuid(7))
  fileId String

  version    Int
  storageKey String
  sizeBytes  BigInt
  checksum   String?

  metadata Json?

  createdAt DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([fileId, createdAt])
}

// ============================================================
// CONVERSATIONS / MESSAGES
// ============================================================

model Conversation {
  id String @id @default(uuid(7))

  accountId String
  userId    String

  projectId String?
  product   ProductCode

  title  String?
  status ConversationStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([accountId, product, updatedAt])
  @@index([userId, updatedAt])
  @@index([projectId])
  @@index([status])
}

model Message {
  id String @id @default(uuid(7))

  conversationId String
  userId         String?

  role MessageRole

  content Json

  model    String?
  provider String?

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// NOTIFICATIONS / SETTINGS
// ============================================================

model Notification {
  id String @id @default(uuid(7))

  accountId String
  userId    String

  type NotificationType

  title String
  body  String

  readAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([accountId, createdAt])
}

model UserSettings {
  id String @id @default(uuid(7))

  accountId String @unique
  userId    String @unique

  locale   String @default("en-US")
  timezone String @default("UTC")

  preferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SECURITY / AUDIT
// ============================================================

model AuditLog {
  id String @id @default(uuid(7))

  accountId String?
  userId    String?

  action   AuditAction
  severity AuditSeverity @default(INFO)

  resourceType String?
  resourceId   String?

  result    AuditResult?
  requestId String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([severity, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
}

// ============================================================
// AILA WRITER (docs/products/WRITER.md §7-14, §24-25, §31-33, §48-50)
// ============================================================

// What a Writer project is (WRITER §7).
enum WriterDocumentType {
  BOOK
  NOVEL
  NONFICTION
  REPORT
  THESIS
  MANUSCRIPT
  GUIDE
  ARTICLE
  BLOG
  DOCUMENTATION
  RESEARCH_NOTES
  OTHER
}

// Levels of the document hierarchy (WRITER §8): Document > Part > Chapter
// > Section. Not every project uses every level.
enum WriterNodeKind {
  DOCUMENT
  PART
  CHAPTER
  SECTION
}

enum WriterNodeStatus {
  DRAFT
  IN_PROGRESS
  REVISED
  FINAL
}

// Why a version was kept (WRITER §14). Autosaves are not versions; a
// MILESTONE is kept automatically after a long stretch of autosaved edits.
enum WriterVersionSource {
  MANUAL
  MILESTONE
  AI
  RESTORE
}

enum WriterResearchKind {
  QUESTION
  NOTE
  SOURCE
}

enum WriterExportFormat {
  PDF
  DOCX
  EPUB
}

enum WriterExportStatus {
  PROCESSING
  READY
  FAILED
}

// A persistent writing work owned by one account (WRITER §7). Project
// context (style, terminology, characters, setting) and goals live here.
model WriterProject {
  id          String @id @default(uuid(7))
  accountId   String
  createdById String

  title        String
  subtitle     String?
  description  String?
  documentType WriterDocumentType @default(BOOK)
  language     String             @default("en")
  audience     String?
  authorName   String?

  // Project context (WRITER §22), editable by the user and sent to the AI
  // as the author's instructions.
  goals             String?
  styleInstructions String?
  terminology       String?
  contextNotes      String?

  // Informational goals (WRITER §30); never block writing.
  wordGoal    Int?
  chapterGoal Int?

  status ProjectStatus @default(ACTIVE)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  nodes         WriterNode[]
  versions      WriterVersion[]
  researchItems WriterResearchItem[]
  references    WriterReference[]
  exports       WriterExport[]

  @@index([accountId, status, updatedAt])
  @@index([createdById])
}

// One unit of the hierarchy: a document, part, chapter or section (WRITER
// §8-10). Order among siblings is the stored position, never the client's
// array order. `revision` changes with every content save, so a save based
// on older content is refused instead of overwriting newer work (§13).
model WriterNode {
  id          String  @id @default(uuid(7))
  accountId   String
  projectId   String
  parentId    String?
  createdById String

  kind     WriterNodeKind
  title    String
  summary  String?
  position Int
  status   WriterNodeStatus @default(DRAFT)

  content   String @default("")
  wordCount Int    @default(0)
  charCount Int    @default(0)
  revision  Int    @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // In the project's trash; restorable until the project is deleted.
  deletedAt DateTime?

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project   WriterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    WriterNode?   @relation("WriterNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  WriterNode[]  @relation("WriterNodeTree")
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  versions WriterVersion[]
  exports  WriterExport[]

  @@index([projectId, parentId, position])
  @@index([accountId, projectId])
  @@index([projectId, deletedAt])
}

// A kept copy of a node's title and content (WRITER §14-15). Versions are
// never changed; a restore adds new versions instead of removing any.
model WriterVersion {
  id          String  @id @default(uuid(7))
  accountId   String
  projectId   String
  nodeId      String
  createdById String?

  versionNumber Int
  revision      Int
  source        WriterVersionSource
  label         String?

  title     String
  content   String
  wordCount Int

  createdAt DateTime @default(now())

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project   WriterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node      WriterNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([nodeId, versionNumber])
  @@index([accountId, projectId])
  @@index([nodeId, createdAt])
}

// Research questions, notes and sources (WRITER §24). A source keeps its
// URL and title so attribution is preserved.
model WriterResearchItem {
  id          String @id @default(uuid(7))
  accountId   String
  projectId   String
  createdById String

  kind        WriterResearchKind
  title       String
  body        String?
  url         String?
  sourceTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project   WriterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([accountId])
}

// A file from the account's Files attached to a project as reference
// material (WRITER §25). The file itself stays in the shared file service.
model WriterReference {
  id          String @id @default(uuid(7))
  accountId   String
  projectId   String
  fileId      String
  createdById String

  createdAt DateTime @default(now())

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project   WriterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file      File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, fileId])
  @@index([accountId])
  @@index([fileId])
}

// One export request and its result (WRITER §31-33). The generated file is
// a private GENERATED file in the shared file service. `requestKey` makes a
// repeated submission return the same export instead of running twice.
model WriterExport {
  id          String  @id @default(uuid(7))
  accountId   String
  projectId   String
  // Null when the whole project was exported.
  nodeId      String?
  fileId      String? @unique
  createdById String

  format     WriterExportFormat
  status     WriterExportStatus @default(PROCESSING)
  requestKey String
  fileName   String
  sizeBytes  Int?
  errorCode  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project   WriterProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node      WriterNode?   @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  file      File?         @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([accountId, requestKey])
  @@index([projectId, createdAt])
}
