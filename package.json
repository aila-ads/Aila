{
  "name": "aila",
  "version": "0.1.0",
  "private": true,
  "description": "Aila — think, create, and build.",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --filter @aila/web dev",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.5"
  }
}
