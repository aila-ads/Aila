# Aila environment configuration
# Never commit a real .env file or real credentials.

NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aila?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Supabase Auth)
# Public values from Supabase > Project Settings > API. Both are exposed to
# the browser; never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# AI providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Billing
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# Storage
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email
EMAIL_FROM=""
EMAIL_PROVIDER_API_KEY=""

# Observability
SENTRY_DSN=""
