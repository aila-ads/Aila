# Aila environment configuration
# Never commit a real .env file or real credentials.

NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aila?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Neon Auth). Server-only; read at runtime, never exposed
# to the browser. Base URL from Neon Console > Auth > Configuration.
NEON_AUTH_BASE_URL=
# At least 32 characters, e.g. generated with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Authentication rate limiting (Upstash Redis REST). Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI gateway (OpenRouter). Server-only; read at request time, never
# exposed to the browser. Use a key with a credit limit.
OPENROUTER_API_KEY=""

# Billing
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# Storage
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email
EMAIL_FROM=""
EMAIL_PROVIDER_API_KEY=""

# Observability
SENTRY_DSN=""
